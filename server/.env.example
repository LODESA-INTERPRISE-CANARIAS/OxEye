# OxEye Logistics Manager backend: copy to server/.env (never commit .env).
# These values are for the local Docker database only. On the external server
# use long random passwords and real origins.

# PostgreSQL container (docker-compose.yml reads these).
POSTGRES_USER=oxeye
POSTGRES_PASSWORD=oxeye_local_only
POSTGRES_DB=oxeye_logistics

# Connection used by the API and the db:* commands run on this machine.
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgres://oxeye:oxeye_local_only@localhost:5433/oxeye_logistics
# Without Docker (development only): embedded database in server/pgdata/pglite.
# DATABASE_URL=pglite:./pgdata/pglite

# HTTP server. 0.0.0.0 listens on every interface (needed inside Docker).
HOST=0.0.0.0
PORT=8787

# Browser origins allowed to call the API from another origin, comma separated.
# In development the Vite proxy makes requests same-origin; the default covers
# http://localhost:5173. In production set the real web address(es).
CORS_ORIGINS=http://localhost:5173

# Days a session stays valid without use (sliding).
SESSION_DAYS=30

# development | production | test
NODE_ENV=development

# Apply pending migrations when the API starts (the container sets it to true).
MIGRATE_ON_START=false

# Reverse proxies in front of the API that append to X-Forwarded-For
# (used only to key the per-IP login limit).
#   false (or 0): no proxy; the header is ignored.
#   true  (or 1): one proxy, e.g. nginx or Caddy on the same server.
#   2, 3…       : that many proxies chained (e.g. a CDN plus nginx).
# The client IP is the entry that many places from the right; entries further
# left are written by the client and ignored. Set it only if the API port is
# reachable solely through the proxy.
TRUST_PROXY=false

# Docker Compose (profile `full`): host address the API container is published
# on. Loopback by default so only a proxy on the same host reaches it.
API_BIND=127.0.0.1

# Account e-mails (password recovery and recovery e-mail verification).
# Without SMTP_HOST nothing is sent: in development the link is printed in the
# API console; in production only "mail queued to <masked address>" is logged.
# Gmail: an App Password (see server/README.md), smtp.gmail.com, port 465.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# true for port 465 (TLS from the start); false for 587 (STARTTLS, required).
# SMTP_SECURE=true
# SMTP_USER=cuenta-del-proyecto@example.org
# SMTP_PASS=app-password-here
# Sender shown in the e-mail; required with SMTP_HOST.
# MAIL_FROM=OxEye <cuenta-del-proyecto@example.org>

# Where reset links go for accounts without a verified personal e-mail (the
# shared «Equipo» account and anyone who has not added one). Never shown in
# the app or in any API response.
# RECOVERY_FALLBACK_EMAIL=buzon-del-proyecto@example.org

# Web address the links in e-mails open (without #logistica), for example
# https://usuario.github.io/OxEye. Unset: the request's Origin, if it is one of
# CORS_ORIGINS. With `npm run equipo` the tunnel address is new every time, so
# «¿Olvidaste tu contraseña?» sends no link there; an administrator's reset
# link still works (it uses the administrator's own address).
# PUBLIC_APP_URL=https://equipo.example.org
