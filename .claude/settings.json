{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableClaudeAiConnectors": true,
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch --show-current)",
      "Bash(npx tsc --noEmit -p tsconfig.json)",
      "Bash(npx vitest run *)",
      "Bash(npm run test)",
      "Bash(npm run lint)",
      "Bash(node --test .claude/hooks/test)"
    ],
    "deny": [
      "PowerShell",
      "Monitor",
      "RemoteTrigger",
      "CronCreate",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "SendToProject",
      "SendToProjectContext",
      "Skill(schedule)",
      "Skill(ship-local)",
      "Skill(ship)",
      "Skill(steward)",
      "Skill(anthropic-skills:chrome-browser)",
      "Skill(anthropic-skills:computer-use)",
      "mcp__claude_ai_Claude_Docs__*",
      "mcp__claude-in-chrome__*",
      "mcp__ide__executeCode",
      "mcp__computer-use__*",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git send-pack *)",
      "Bash(git http-push *)",
      "Bash(git credential *)",
      "Bash(gh)",
      "Bash(gh *)",
      "Bash(npm publish *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Edit(/.claude/**)",
      "Edit(/.git/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.github/**)",
      "Edit(/.mcp.json)",
      "Edit(~/.gitconfig)",
      "Edit(~/.claude/settings*.json)",
      "Read(~/.git-credentials)",
      "Read(//c/Users/*/AppData/Roaming/GitHub CLI/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/approval-token.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-write.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-agent.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
