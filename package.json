{
  "name": "oxeye",
  "private": true,
  "version": "0.16.0",
  "description": "Ojo de Buey (OxEye) · Gestor y simulador en vivo de eventos sobre planos georreferenciados de San Cristóbal de La Laguna",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "equipo": "node scripts/equipo.mjs",
    "equipo:api": "npm --prefix server run start",
    "equipo:web": "vite build --mode equipo && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "equipo:tunel": "cloudflared tunnel --url http://localhost:4173 --http-host-header localhost:4173",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"shared/**/*.ts\" \"server/src/**/*.ts\" \"server/tests/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"shared/**/*.ts\" \"server/src/**/*.ts\" \"server/tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "docs": "typedoc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "gts": "^6.0.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typedoc": "^0.27.6",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
